{
    "name":  "qcy-livelog-monitor",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Desktop SSH access-log monitor with Smart activity grouping, live filtering and secure server profiles.",
    "scripts":  {
                    "dev":  "tsx src/index.ts",
                    "build":  "tsc -p tsconfig.json \u0026\u0026 node scripts/copy-electron-assets.mjs",
                    "start":  "node dist/index.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "desktop":  "npm run build \u0026\u0026 electron ."
                },
    "dependencies":  {
                         "@inquirer/prompts":  "^8.7.2",
                         "ssh2":  "^1.17.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^26.6.4",
                            "@types/ssh2":  "^1.15.6",
                            "electron":  "^44.5.1",
                            "tsx":  "^4.23.15",
                            "typescript":  "^7.0.2"
                        },
    "main":  "dist/electron/main.js",
    "author":  "QvarcY",
    "license":  "MIT",
    "homepage":  "https://github.com/QvarcY/qcy-livelog-monitor",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/QvarcY/qcy-livelog-monitor.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/QvarcY/qcy-livelog-monitor/issues"
             },
    "keywords":  [
                     "ssh",
                     "logs",
                     "access-log",
                     "monitoring",
                     "electron",
                     "apache",
                     "nginx",
                     "security",
                     "developer-tools"
                 ]
}
