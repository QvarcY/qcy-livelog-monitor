{
  "name": "qcy-livelog-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop SSH access-log monitor with Smart activity grouping, live filtering and secure server profiles.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-electron-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "dist/electron/main.js",
  "author": "QvarcY",
  "license": "MIT",
  "homepage": "https://github.com/QvarcY/qcy-livelog-monitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QvarcY/qcy-livelog-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/QvarcY/qcy-livelog-monitor/issues"
  },
  "keywords": [
    "ssh",
    "logs",
    "access-log",
    "monitoring",
    "electron",
    "apache",
    "nginx",
    "security",
    "developer-tools"
  ],
  "build": {
    "appId": "io.github.qvarcy.qcy-livelog-monitor",
    "productName": "QcY LiveLog Monitor",
    "artifactName": "QcY-LiveLog-Monitor-v${version}-Windows-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
