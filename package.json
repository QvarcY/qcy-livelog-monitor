{
  "name": "area-live-logs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Near-real-time access log viewer for hosted web projects over SSH.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
